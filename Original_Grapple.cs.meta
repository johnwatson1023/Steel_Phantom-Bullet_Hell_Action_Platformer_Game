using UnityEngine;
using UnityEngine.EventSystems;
using System.Collections;

public class Original_Grapple : MonoBehaviour
{
    [SerializeField] DigitalWorlds.StarterPackage2D.PlayerMovementAdvanced pma;
    [SerializeField] DigitalWorlds.StarterPackage2D.PlayerMovement2D pm;
    [SerializeField] Camera cam;
    [SerializeField] Transform tf;
    private Rigidbody2D rb;

    public LayerMask layerMask = ~0;
    public float maxDistance = 100f;
    public bool isGrappling = false;
    [SerializeField] float grappleTime = 0.5f;
    public Vector2 grappleVector;
    [SerializeField] float stopTime = 1;
    [SerializeField] float x_axis_multiplier;
    [SerializeField] float y_axis_multiplier;

    private void Awake()
    {
        if (cam == null) cam = Camera.main;
        rb = GetComponent<Rigidbody2D>();
    }

    private void Update()
    {
        if (Input.GetMouseButtonDown(1))
        {
            if (EventSystem.current != null && EventSystem.current.IsPointerOverGameObject())
                return;

            Vector2 mousePos = cam.ScreenToWorldPoint(Input.mousePosition);
            RaycastHit2D hit = Physics2D.Raycast(mousePos, Vector2.zero, maxDistance, layerMask);

            if (hit.collider != null && hit.collider.CompareTag("GrapplePoint") && !isGrappling)
                StartCoroutine(PerformGrapple(hit.point));
        }
    }

    public IEnumerator PerformGrapple(Vector2 targetPoint)
    {
        isGrappling = true;




        rb.linearVelocity = Vector2.zero;
        Vector2 direction = (targetPoint - (Vector2) transform.position).normalized;
        direction.x *= x_axis_multiplier;
        direction.y *= y_axis_multiplier;
        grappleVector = (direction * pma.dashForce);
        rb.linearVelocity = Vector2.zero;
        rb.AddForce(grappleVector, ForceMode2D.Impulse);

        pm.jumpsRemaining = pm.jumps;

        Vector2 initialGrappleVector = grappleVector;
        float elapsed = 0f;

        while (elapsed < stopTime)
        {
            elapsed += Time.deltaTime;
            float t = elapsed / stopTime;
            grappleVector = Vector2.Lerp(initialGrappleVector, Vector2.zero, t);
            yield return null;
        }

        grappleVector = Vector2.zero;

        //isGrappling is being set to false inside PlayerMovementAdvanced script
    }
}